# Copy this file to .env and fill in the values. Never commit the real file.
#
# Spring Boot does not read .env on its own - it reads environment variables.
# Export them before starting the app, for example from Git Bash at the project
# root:
#
#     set -a; . ./.env; set +a
#     cd backend && ./mvnw spring-boot:run
#
# An IDE run configuration, `docker run --env-file .env` and a systemd
# EnvironmentFile do the same job. What matters is that the values are in the
# environment of the Java process, not that a file called .env exists.

# JDBC URL of the database this application owns. Point it at a schema that
# holds nothing else.
# FREEPDB1 is the pluggable database created by Oracle Database Free (23ai or 26ai).
LEAVE_DB_URL=jdbc:oracle:thin:@//127.0.0.1:1521/FREEPDB1

# Scoped database user (schema) created by a database administrator.
LEAVE_DB_USER=LEAVEAPP

# Password for the scoped user. Leave empty in the committed file.
LEAVE_DB_PASSWORD=

# JDBC connection pool size. Oracle Free allows a limited number of sessions,
# so keep this small and raise it only after checking the database limit.
LEAVE_DB_POOL_SIZE=10

# HTTP port for the backend (default 8080).
LEAVE_SERVER_PORT=8080

# Flyway migrations on startup (true/false).
LEAVE_FLYWAY_ENABLED=true

# Session cookie over HTTPS only. Set to true in staging and production.
LEAVE_COOKIE_SECURE=false

# What one visitor may ask of the sign-in security code. All four sit far above
# anything a person reaches at the screen: their job is to cap a script, not to
# slow a visitor down. A whole building behind one campus address is one address
# to these counts, so raise the first for a building, never for a bot.
LEAVE_CAPTCHA_PICTURES_PER_ADDRESS=120
LEAVE_CAPTCHA_PICTURES_PER_SESSION=40
LEAVE_CAPTCHA_WRONG_CODES=3
LEAVE_CAPTCHA_WAIT_SECONDS=120

# How many printed forms one address may check in a minute. The check is open on
# purpose, so a crowded office scanning paper is ordinary traffic; what the count
# ends is a machine working through numbers.
LEAVE_VERIFY_CHECKS_PER_ADDRESS=60

# Text that encrypts the SMTP password saved on the Administration screen.
# Without it the platform still stores a host, port and sender address but
# refuses to store a password. Leave empty in the committed file; the value
# never goes in the database, so a copied schema is not a set of mail
# credentials.
LEAVE_MAIL_KEY=

# Text that signs the verification code printed on a leave application form, so
# a sheet of paper can be checked from its number alone. Like the mail key it
# stays out of the database: whoever holds a copy of the schema, or of this
# repository, must not be able to mint a code for a request of their choosing.
# Leave empty in the committed file. Without it the forms still print - with the
# number in letters and no picture - and the public check refuses everything.
LEAVE_VERIFY_KEY=

# Text that seals the authenticator seeds saved on each account, so a copied
# database is not a bag of second factors. Without it the sign-in screens still
# work and every account keeps signing in with its password alone; the platform
# refuses to set two-step up at all, rather than save a seed it cannot seal.
# Losing it later means every enrolled person sets their app up again from
# scratch - nothing else breaks, and nobody can sign in as them in between.
# Leave empty in the committed file.
LEAVE_TWOSTEP_KEY=

# The name an authenticator app shows beside the account, so somebody with three
# universities in one app knows which number belongs to this one.
LEAVE_TWOSTEP_ISSUER=University Leave

# The address this platform is reached at from outside, for example
# https://leave.nedu.edu.pk. It is only used to put a full address inside the
# QR picture, so a phone opened at the paper reads the answer on its own.
# Leaving it empty is normal on a laptop or an intranet trial: the picture then
# holds the same number and code as one short line to type at the desk.
LEAVE_PUBLIC_URL=

# First administrator, created once on an empty schema and then ignored. This is
# not optional on a fresh database: the migrations load reference data only, so
# without it there is no account to sign in with and no way to make one.
# All four of username, password, email and department must be set together.
# Remove them from the environment once the account exists.
LEAVE_BOOTSTRAP_ADMIN_USERNAME=
LEAVE_BOOTSTRAP_ADMIN_PASSWORD=
LEAVE_BOOTSTRAP_ADMIN_EMAIL=
# A department code from the organization V006 loads. ADMIN is Central
# Administration. The SAMPLE- codes of V002 are deleted by V006 and will not
# work here.
LEAVE_BOOTSTRAP_ADMIN_DEPARTMENT=ADMIN
LEAVE_BOOTSTRAP_ADMIN_EMPLOYEE_NO=ADMIN-001
LEAVE_BOOTSTRAP_ADMIN_NAME=
LEAVE_BOOTSTRAP_ADMIN_DESIGNATION=